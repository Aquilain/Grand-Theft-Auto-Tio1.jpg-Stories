<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grand Theft Auto: Inciclopedia Stories</title>
    <style>
        body {
            background-color: #0a0512;
            color: #a349a4;
            font-family: 'Impact', 'Arial Black', sans-serif;
            text-align: center;
            margin: 0;
            padding: 10px;
        }
        h1 {
            color: #00f0ff;
            text-shadow: 3px 3px #ff00ff, -3px -3px #000;
            font-size: 38px;
            margin: 5px 0;
            letter-spacing: 2px;
        }
        .subtitle {
            color: #fff;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            margin-bottom: 15px;
            text-shadow: 1px 1px #000;
        }
        #game-frame {
            position: relative;
            display: inline-block;
            border: 6px double #00f0ff;
            background-color: #000;
            box-shadow: 0 0 25px #ff00ff;
        }
        .hud {
            display: flex;
            justify-content: space-between;
            background: linear-gradient(90deg, #ff00ff, #00f0ff);
            color: #fff;
            padding: 8px 15px;
            font-family: 'Courier New', monospace;
            font-weight: bold;
            font-size: 16px;
            text-shadow: 1px 1px #000;
        }
        canvas {
            display: block;
            background: #12061c;
        }
        .overlay {
            position: absolute;
            top: 38px;
            left: 0;
            width: 800px;
            height: 450px;
            background: rgba(15, 5, 25, 0.95);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #fff;
            font-family: 'Courier New', monospace;
            padding: 20px;
            box-sizing: border-box;
            text-align: center;
        }
        .overlay h2 {
            color: #ff00ff;
            font-size: 28px;
            margin-bottom: 10px;
            font-family: 'Impact', sans-serif;
            text-shadow: 2px 2px #00f0ff;
        }
        .overlay p {
            font-size: 15px;
            line-height: 1.4;
            max-width: 600px;
            color: #ddd;
        }
        button {
            background: #00f0ff;
            color: #000;
            border: 3px solid #ff00ff;
            padding: 10px 25px;
            font-size: 18px;
            font-family: 'Impact', sans-serif;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.2s;
        }
        button:hover {
            background: #ff00ff;
            color: #fff;
            box-shadow: 0 0 10px #00f0ff;
        }
        .hidden { display: none !important; }
        .easter-egg {
            margin-top: 10px;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: #555;
        }
    </style>
</head>
<body>

    <h1>GTA: INCICLOPEDIA STORIES</h1>
    <div class="subtitle">Exclusivo para PlayStation 5 — Lanzamiento: 06/06/7016</div>

    <div id="game-frame">
        <div class="hud">
            <div>MISIÓN: <span id="hud-mission-name">I. Without a face</span></div>
            <div>OBJETIVO: <span id="hud-objective">Colapsar la Wiki</span></div>
            <div>PUNTUACIÓN: <span id="hud-score">0</span></div>
        </div>

        <canvas id="gtaCanvas" width="800" height="450"></canvas>

        <div id="screen-overlay" class="overlay">
            <h2 id="overlay-title">INTRODUCCIÓN</h2>
            <p id="overlay-text">Tras sobrevivir a un tsunami provocado por la Wikiestrella de la Muerte, despiertas en Tuvalu Ulterior como el misterioso Anonymous (vistiendo una llamativa camisa hawaiana y gafas oscuras). Es hora de buscar fama, acción y dinero.</p>
            <button id="overlay-btn" onclick="advanceStage()">INICIAR MISIÓN I</button>
        </div>
    </div>

    <div class="easter-egg">
        * Si miras a la izquierda de la pantalla, verás una roca partida que dice "Chuck Norris was here". *
    </div>

<script>
    const canvas = document.getElementById("gtaCanvas");
    const ctx = canvas.getContext("2d");

    // Componentes de la interfaz
    const overlay = document.getElementById("screen-overlay");
    const oTitle = document.getElementById("overlay-title");
    const oText = document.getElementById("overlay-text");
    const oBtn = document.getElementById("overlay-btn");
    
    const hudMission = document.getElementById("hud-mission-name");
    const hudObjective = document.getElementById("hud-objective");
    const hudScore = document.getElementById("hud-score");

    // Variables de control del juego
    let currentStage = 0; 
    let gameLoopInterval;
    let isPlaying = false;
    let score = 0;
    let keys = {};

    // Entidades configurables
    let player, entities, goals;

    // Escuchar teclado
    window.addEventListener("keydown", e => keys[e.key] = true);
    window.addEventListener("keyup", e => keys[e.key] = false);

    // Definición de las locas misiones del texto
    const missionsData = [
        {
            title: "Misión I. Without a face",
            intro: "Te has unido a la banda de Guy2.jpg para vandalizar los servidores de la Wikipedia. ¡Esquiva las patrullas de la poli y recoge los servidores antes de huir a la guarida en coche!",
            objective: "Recoge 5 servidores corruptos",
            targetType: "servidor",
            enemyType: "cop",
            targetGoal: 5
        },
        {
            title: "Misión III. Lovely",
            intro: "Guy1.jpg quiere arreglar su extrema fealdad usando a Bob Esponja como exfoliante facial. Conduce la limusina rosa por los barrios bajos de Ukelele y atrapa a la esponja marginada.",
            objective: "Atrapa a Bob Esponja",
            targetType: "bob",
            enemyType: "bache",
            targetGoal: 1
        },
        {
            title: "Misión V & VI. Diagnosis & Vicodin",
            intro: "El doctor Gregory House está en estado de Nirvana y necesita dosis masivas de Vicodín. Roba el cargamento en el puerto esquivando a los matones de La Innombrable.",
            objective: "Recolecta 8 botes de Vicodín",
            targetType: "vicodin",
            enemyType: "innombrable",
            targetGoal: 8
        },
        {
            title: "Misión XII. Awakening of Mr. Norris",
            intro: "¡La batalla final! Chuck Norris ha venido a ayudarte a destruir la sede central, pero está herido. Tienes que lanzarle porros medicinales para activar su furia destructora instantánea.",
            objective: "Dale 10 porros a Chuck Norris",
            targetType: "chuck",
            enemyType: "fbi",
            targetGoal: 10
        }
    ];

    function showOverlay(title, text, buttonLabel) {
        isPlaying = false;
        clearInterval(gameLoopInterval);
        oTitle.innerText = title;
        oText.innerText = text;
        oBtn.innerText = buttonLabel;
        overlay.classList.remove("hidden");
    }

    function advanceStage() {
        overlay.classList.add("hidden");
        if (currentStage < missionsData.length) {
            setupStage(currentStage);
        } else {
            // Fin del juego definitivo
            currentStage = 0;
            score = 0;
            hudScore.innerText = score;
            showOverlay("¡HISTORIA COMPLETADA (POR AHORA)!", "Has conquistado Tuvalu Ulterior, derrotado a La Innombrable con ayuda de Chuck Norris y asegurado tu puesto en la Inciclopedia. ¡Chan Chan CHAN!", "VOLVER A JUGAR");
        }
    }

    function setupStage(stageIndex) {
        const data = missionsData[stageIndex];
        
        // Actualizar HUD
        hudMission.innerText = data.title;
        hudObjective.innerText = data.objective;

        // Resetear entidades
        player = {
            x: 100, y: 220,
            width: 45, height: 45,
            speed: 5,
            collected: 0,
            // Aspecto basado en la portada (camisa cian, jeans azul)
            colorShirt: "#00f0ff",
            colorJeans: "#355796"
        };

        entities = [];
        goals = [];

        // Spawn inicial de objetivos según la misión
        for (let i = 0; i < (data.targetType === 'bob' ? 1 : 4); i++) {
            spawnGoal(data.targetType);
        }

        // Spawn inicial de enemigos desafiantes
        for (let i = 0; i < 4; i++) {
            spawnEnemy(data.enemyType);
        }

        isPlaying = true;
        clearInterval(gameLoopInterval);
        gameLoopInterval = setInterval(updateGame, 1000 / 60);
    }

    function spawnGoal(type) {
        goals.push({
            x: 200 + Math.random() * (canvas.width - 250),
            y: 50 + Math.random() * (canvas.height - 100),
            width: 25, height: 25,
            type: type
        });
    }

    function spawnEnemy(type) {
        entities.push({
            x: canvas.width + Math.random() * 300,
            y: 40 + Math.random() * (canvas.height - 90),
            width: 30, height: 35,
            speed: 3 + Math.random() * 4,
            type: type
        });
    }

    function updateGame() {
        if (!isPlaying) return;

        const data = missionsData[currentStage];

        // --- MOVIMIENTO DEL PROTAGONISTA ---
        if (keys["ArrowUp"] || keys["w"] || keys["W"]) player.y -= player.speed;
        if (keys["ArrowDown"] || keys["s"] || keys["S"]) player.y += player.speed;
        if (keys["ArrowLeft"] || keys["a"] || keys["A"]) player.x -= player.speed;
        if (keys["ArrowRight"] || keys["d"] || keys["D"]) player.x += player.speed;

        // Colisiones con los bordes de la pantalla de Tuvalu
        if (player.x < 0) player.x = 0;
        if (player.x > canvas.width - player.width) player.x = canvas.width - player.width;
        if (player.y < 40) player.y = 40;
        if (player.y > canvas.height - player.height) player.y = canvas.height - player.height;

        // --- LÓGICA DE ENEMIGOS ---
        entities.forEach((enemy, idx) => {
            enemy.x -= enemy.speed;
            if (enemy.x < -enemy.width) {
                entities.splice(idx, 1);
                spawnEnemy(data.enemyType);
            }

            // Si colisionas con un enemigo penoso
            if (checkCollision(player, enemy)) {
                score = Math.max(0, score - 10);
                hudScore.innerText = score;
                // Reposicionar enemigo para dar tregua
                enemy.x = canvas.width + Math.random() * 200;
            }
        });

        // --- LÓGICA DE OBJETIVOS ---
        goals.forEach((goal, idx) => {
            if (checkCollision(player, goal)) {
                goals.splice(idx, 1);
                player.collected++;
                score += 100;
                hudScore.innerText = score;

                if (player.collected >= data.targetGoal) {
                    // Misión superada con éxito
                    currentStage++;
                    if (currentStage < missionsData.length) {
                        showOverlay("¡MISIÓN CUMPLIDA!", `Lograste el objetivo: ${data.objective}. Prepárate para el siguiente encargo de la mafia tuvaliense.`, "Siguiente Misión");
                    } else {
                        advanceStage();
                    }
                } else {
                    spawnGoal(data.targetType);
                }
            }
        });

        // --- RENDERIZADO GRÁFICO (Calidad extrema tipo Chernobyl) ---
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Dibujar carretera/calle de Ukelele
        ctx.fillStyle = "#1b1126";
        ctx.fillRect(0, 40, canvas.width, canvas.height - 40);
        
        ctx.strokeStyle = "#ff00ff";
        ctx.lineWidth = 2;
        ctx.setLineDash([20, 15]);
        ctx.beginPath();
        ctx.moveTo(0, canvas.height/2);
        ctx.lineTo(canvas.width, canvas.height/2);
        ctx.stroke();
        ctx.setLineDash([]); // reset

        // Dibujar Objetivos
        goals.forEach(goal => {
            ctx.font = "24px Arial";
            let icon = "💾";
            if (goal.type === 'bob') icon = "🧽";
            if (goal.type === 'vicodin') icon = "💊";
            if (goal.type === 'chuck') icon = "🍁";
            ctx.fillText(icon, goal.x, goal.y + 20);
        });

        // Dibujar Enemigos
        entities.forEach(enemy => {
            ctx.fillStyle = enemy.type === 'cop' ? '#0000ff' : '#ff3333';
            ctx.fillRect(enemy.x, enemy.y, enemy.width, enemy.height);
            ctx.font = "14px monospace";
            ctx.fillStyle = "#fff";
            let label = "⚠️";
            if (enemy.type === 'cop') label = "🚓";
            if (enemy.type === 'innombrable') label = "🕵️";
            ctx.fillText(label, enemy.x + 5, enemy.y + 22);
        });

        // Dibujar al Protagonista (Inspirado fielmente en la portada adjunta)
        // Cuerpo (Camisa hawaiana cian y vaqueros)
        ctx.fillStyle = player.colorShirt;
        ctx.fillRect(player.x, player.y + 12, player.width, 18); // Camisa
        ctx.fillStyle = player.colorJeans;
        ctx.fillRect(player.x + 4, player.y + 30, player.width - 8, 15); // Vaqueros

        // Cabeza con el glorioso pelo y las gafas de sol de la portada
        ctx.fillStyle = "#f3d3b2"; // Piel
        ctx.fillRect(player.x + 10, player.y, 25, 15);
        
        ctx.fillStyle = "#5c4033"; // Pelo castaño de Tio1.jpg
        ctx.fillRect(player.x + 8, player.y, 29, 5); 
        ctx.fillRect(player.x + 8, player.y, 5, 14); // Mechón lateral izquierdo
        ctx.fillRect(player.x + 32, player.y, 5, 14); // Mechón lateral derecho

        ctx.fillStyle = "#000"; // Gafas de sol oscuras
        ctx.fillRect(player.x + 14, player.y + 5, 8, 5);
        ctx.fillRect(player.x + 24, player.y + 5, 8, 5);

        ctx.fillStyle = "#221100"; // El icónico bigote
        ctx.fillRect(player.x + 16, player.y + 11, 14, 3);
    }

    function checkCollision(r1, r2) {
        return r1.x < r2.x + r2.width &&
               r1.x + r1.width > r2.x &&
               r1.y < r2.y + r2.height &&
               r1.y + r1.height > r2.y;
    }
</script>
</body>
</html>
