<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>La Premisa - Motor Sistémico</title>
    <style>
        :root {
            --bg: #0f172a;
            --panel: #1e293b;
            --text: #cbd5e1;
            --accent: #38bdf8;
            --danger: #ef4444;
            --success: #22c55e;
            --warning: #f59e0b;
        }

        body {
            font-family: 'Courier New', Courier, monospace;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        header {
            background-color: #020617;
            padding: 15px 20px;
            border-bottom: 2px solid var(--accent);
            text-align: center;
        }

        header h1 {
            margin: 0;
            color: var(--accent);
            font-size: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .container {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        .panel {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            border-right: 1px solid #334155;
            background: var(--panel);
        }

        .panel:last-child {
            border-right: none;
        }

        h2 {
            font-size: 1.2rem;
            border-bottom: 1px solid #475569;
            padding-bottom: 5px;
            margin-top: 0;
            color: white;
        }

        /* Botones de Acción */
        .btn {
            display: block;
            width: 100%;
            padding: 12px;
            margin-bottom: 10px;
            background: #334155;
            color: white;
            border: 1px solid #475569;
            border-radius: 4px;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.2s;
            text-align: left;
        }

        .btn:hover { background: #475569; border-color: var(--accent); }
        .btn.danger:hover { background: var(--danger); border-color: white; }
        .btn.time:hover { background: var(--warning); color: #000; }

        /* Consola de Eventos */
        #log {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .log-entry {
            padding: 10px;
            background: #0f172a;
            border-left: 3px solid var(--accent);
            border-radius: 0 4px 4px 0;
            animation: fadeIn 0.3s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Estadísticas */
        .stat-group {
            margin-bottom: 15px;
            background: #0f172a;
            padding: 10px;
            border-radius: 4px;
        }

        .stat-group span {
            font-weight: bold;
            color: var(--accent);
        }
    </style>
</head>
<body>

    <header>
        <h1>La Premisa: Simulación Activa</h1>
    </header>

    <div class="container">
        <!-- PANEL IZQUIERDO: ESTADO DEL MUNDO -->
        <div class="panel">
            <h2>Estado del Mundo</h2>
            
            <div class="stat-group">
                <h3>🕰️ Tiempo y Legado</h3>
                <p>Generación: <span id="ui-gen">1</span></p>
                <p>Mes actual: <span id="ui-mes">1</span></p>
                <p>Edad del personaje: <span id="ui-edad">20</span> años</p>
            </div>

            <div class="stat-group">
                <h3>🌍 Ecosistema</h3>
                <p>Clima: <span id="ui-clima">Viento Fuerte</span></p>
                <p>Estado del Río: <span id="ui-rio">Fluyendo (Presa Intacta)</span></p>
                <p>Bosque: <span id="ui-bosque">Denso</span></p>
            </div>

            <div class="stat-group">
                <h3>⚖️ Sociedad y Economía</h3>
                <p>Reputación Comercial: <span id="ui-rep">Neutral</span></p>
                <p>Precio Insumos: <span id="ui-precio">Normal (1x)</span></p>
                <p>Guerra Civil: <span id="ui-guerra">En tablas</span></p>
            </div>
        </div>

        <!-- PANEL CENTRAL: EL MUNDO VIVO (LOG) -->
        <div class="panel" style="flex: 1.5;">
            <h2>Historial de Efectos (Efecto Dominó)</h2>
            <div id="log">
                <div class="log-entry">El mundo comienza a girar. Eres un joven aventurero sin nombre. El reino está sumido en una guerra civil.</div>
            </div>
        </div>

        <!-- PANEL DERECHO: ACCIONES -->
        <div class="panel">
            <h2>Acciones (Sin Scripts)</h2>
            
            <p><small>1. Química y Físicas</small></p>
            <button class="btn danger" onclick="accionFuego()">🔥 Combinar Fuego + Magia de Viento en el Bosque</button>
            <button class="btn danger" onclick="accionPresa()">💣 Destruir la Presa del Río</button>
            
            <p><small>2. Memoria de NPCs</small></p>
            <button class="btn danger" onclick="accionTraicionar()">🗡️ Robar y Traicionar al Mercader Local</button>
            
            <p><small>3. Tiempo Dinástico</small></p>
            <button class="btn time" onclick="pasarTiempo(1)">⏳ Pasar 1 Mes explorando</button>
            <button class="btn time" onclick="pasarTiempo(60)">💀 Viaje largo (Pasar 5 años)</button>
        </div>
    </div>

    <script>
        // VARIABLES DE SIMULACIÓN SISTÉMICA
        let gameState = {
            mes: 1,
            generacion: 1,
            edad: 20,
            bosque: 'denso',
            rio: 'fluyendo',
            clima: 'viento',
            reputacion: 100, // Base 100
            precioEconomia: 1,
            guerra: 50, // 50 es tablas, <10 ganan rebeldes, >90 gana imperio
            
            // Efectos a largo plazo (Memoria del mundo)
            mesSequia: null,
            mesVenganza: null,
            fuegoPropagandose: false
        };

        // Función principal para imprimir en el mundo vivo
        function log(mensaje, colorBorder = '#38bdf8') {
            const logDiv = document.getElementById('log');
            const entry = document.createElement('div');
            entry.className = 'log-entry';
            entry.style.borderLeftColor = colorBorder;
            entry.innerHTML = `<strong>[Mes ${gameState.mes}]</strong> ${mensaje}`;
            logDiv.prepend(entry);
        }

        // Función para actualizar la Interfaz Gráfica
        function updateUI() {
            document.getElementById('ui-gen').innerText = gameState.generacion;
            document.getElementById('ui-mes').innerText = gameState.mes;
            document.getElementById('ui-edad').innerText = gameState.edad;
            
            document.getElementById('ui-rio').innerText = gameState.rio === 'fluyendo' ? 'Fluyendo (Presa Intacta)' : 'Inundando campamentos (Presa Destruida)';
            document.getElementById('ui-bosque').innerText = gameState.bosque === 'denso' ? 'Denso' : (gameState.bosque === 'quemado' ? 'Cenizas' : 'En llamas');
            
            let repText = 'Neutral';
            if(gameState.reputacion < 50) repText = 'Odiado';
            if(gameState.reputacion < 0) repText = 'Buscan tu cabeza';
            document.getElementById('ui-rep').innerText = repText;
            
            document.getElementById('ui-precio').innerText = gameState.precioEconomia > 1 ? `Inflado (${gameState.precioEconomia}x)` : 'Normal (1x)';
            
            let guerraText = 'En tablas';
            if(gameState.guerra > 80) guerraText = 'El Imperio domina';
            if(gameState.guerra < 20) guerraText = 'Los Rebeldes controlan la región';
            document.getElementById('ui-guerra').innerText = guerraText;
        }

        // SISTEMAS DE ACCIONES (Físicas, NPCs, Tiempo)
        
        function accionFuego() {
            if (gameState.bosque === 'quemado') {
                log("El bosque ya es ceniza. No hay nada que quemar.", "#64748b");
                return;
            }
            if (gameState.clima === 'viento') {
                gameState.bosque = 'llamas';
                gameState.fuegoPropagandose = true;
                log("La alta densidad vegetal y el viento crean un incendio incontrolable. Las físicas sistémicas han tomado el control.", "#ef4444");
            }
            updateUI();
        }

        function accionPresa() {
            if (gameState.rio !== 'fluyendo') {
                log("La presa ya está destruida.", "#64748b");
                return;
            }
            gameState.rio = 'destruido';
            gameState.mesSequia = gameState.mes + 3; // El efecto ocurrirá en 3 meses
            log("Has volado la presa. El agua inunda el campamento enemigo debajo.", "#38bdf8");
            log("FÍSICAS: El cauce del río ha cambiado de ruta permanentemente.", "#f59e0b");
            updateUI();
        }

        function accionTraicionar() {
            if (gameState.reputacion < 50) {
                log("Los mercaderes ya no confían en ti, no te dejan acercarte.", "#64748b");
                return;
            }
            gameState.reputacion -= 80;
            gameState.precioEconomia += 2.5;
            gameState.mesVenganza = gameState.mes + 48; // Venganza en 4 años (48 meses)
            
            log("Robaste al mercader. No te atacó, pero memorizó tu rostro.", "#ef4444");
            log("SISTEMA DE ECONOMÍA: La red comercial ha subido los precios en la región en tu contra.", "#f59e0b");
            updateUI();
        }

        // SISTEMA DE TIEMPO Y LEGADO
        function pasarTiempo(meses) {
            for (let i = 0; i < meses; i++) {
                gameState.mes++;
                
                // Simulación del clima
                if (Math.random() > 0.8) gameState.clima = gameState.clima === 'viento' ? 'calma' : 'viento';
                
                // Simulación de la Guerra (El mundo no te espera)
                gameState.guerra += (Math.random() * 10 - 5); 

                // Eventos diferidos (Efecto Dominó)
                verificarEfectosSistema();
            }
            
            // Envejecer personaje
            gameState.edad += Math.floor(meses / 12);

            log(`Han pasado ${meses} mes(es)...`, "#cbd5e1");

            // Muerte y Legado
            if (gameState.edad >= 65 || (meses === 60 && Math.random() > 0.7)) {
                log("☠️ Tu personaje ha muerto (por edad, enfermedad o emboscada en el viaje).", "#ef4444");
                log("👑 SISTEMA DE LEGADO: Tomando control de tu descendiente...", "#22c55e");
                gameState.generacion++;
                gameState.edad = 18;
                // La reputación se hereda parcialmente, el mundo mantiene sus cambios físicos
                gameState.reputacion += 20; 
                log("Comienzas una nueva vida. Las decisiones de tu ancestro aún afectan este mundo.", "#22c55e");
            }
            
            updateUI();
        }

        function verificarEfectosSistema() {
            // Propagación de fuego sistémica
            if (gameState.fuegoPropagandose && gameState.clima === 'viento') {
                gameState.bosque = 'quemado';
                gameState.fuegoPropagandose = false;
                log("El incendio forestal ha terminado de arrasar la región. Fauna y flora han sido eliminadas del mapa.", "#ef4444");
            }

            // Consecuencia del río (3 meses después)
            if (gameState.mes === gameState.mesSequia) {
                log("EFECTO DOMINÓ: Debido a que destruiste la presa hace 3 meses, el pueblo colindante se ha quedado sin agua y sus cultivos murieron. Hay hambruna.", "#f59e0b");
            }

            // Consecuencia del mercader (Años después)
            if (gameState.mes === gameState.mesVenganza) {
                log("PSICOLOGÍA Y MEMORIA: Mercenarios pagados por la familia del mercader que traicionaste te han emboscado para cobrar venganza.", "#ef4444");
                // Si el personaje sobrevive o no dependería del combate real, aquí lo castigamos con edad (heridas)
                gameState.edad += 5; 
                log("Sobrevives a duras penas, pero las heridas te envejecen prematuramente.", "#f59e0b");
            }
        }

        // Iniciar
        updateUI();
    </script>
</body>
</html>
